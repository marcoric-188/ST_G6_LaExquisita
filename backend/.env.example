# ============================================================
#  La Exquisita · Configuración del backend
#  Copia este archivo como "backend/.env" y ajusta los valores.
#  ¡Nunca subas el .env a GitHub! (ya está en .gitignore)
# ============================================================

PORT=3000

# ---------- SQL Server ----------
# windows -> Autenticación de Windows (la que usa SSMS por defecto)
# sql     -> usuario y contraseña de SQL Server (DB_USER / DB_PASSWORD)
DB_AUTH=windows
DB_SERVER=localhost
# Nombre de la instancia (si en SSMS te conectas a "localhost\SQL2025", aquí va SQL2025).
# Déjalo vacío si usas la instancia por defecto (MSSQLSERVER).
DB_INSTANCE=SQL2025
DB_NAME=la_exquisita_db

# Solo si DB_AUTH=sql
DB_USER=
DB_PASSWORD=
# DB_PORT=1433

# Driver ODBC (solo DB_AUTH=windows). Vacío = el backend prueba solo:
# "ODBC Driver 18 for SQL Server", "ODBC Driver 17 for SQL Server", "SQL Server Native Client 11.0", "SQL Server"
DB_ODBC_DRIVER=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Crea/actualiza tablas automáticamente al arrancar (no borra datos)
DB_AUTO_MIGRATE=true

# ---------- Seguridad ----------
# Cadena aleatoria de 32+ caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8

# ---------- Asistente IA ----------
# auto  -> usa OpenAI si hay OPENAI_API_KEY; si no, motor local (sin internet, gratis)
# local -> siempre motor local
IA_PROVEEDOR=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
